      "parameters": {
        "mode": "raw",
        "jsonOutput": "=={{ \n  (() => {\n    const slug = (s) => String(s||'')\n      .normalize('NFD').replace(/[\\u0300-\\u036f]/g,'')\n      .toLowerCase().replace(/[^a-z0-9]+/g,'-')\n      .replace(/(^-|-$)/g,'');\n\n    const imoveis = Object.keys($json)\n      .filter(k => /^\\d+$/.test(k))\n      .map(k => {\n        const im = $json[k];\n        const titulo = im.TituloSite || `imovel-${im.Codigo || im.ImoCodigo || ''}`;\n        return {\n          ...im,\n          url: `https://www.toziimoveis.com.br/${slug(titulo)}-${slug(im.Cidade)},${im.ImoCodigo || im.Codigo}`\n        };\n      });\n\n    return { imoveis };\n  })()\n}}",
        "options": {}
